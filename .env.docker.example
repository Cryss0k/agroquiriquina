# Copia como ".env" para usar con: docker compose up --build
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# En producción con HTTPS detrás de Nginx: SECURE_SSL_REDIRECT=True y orígenes https://tu-dominio
SECURE_SSL_REDIRECT=False
DB_NAME=agroquiriquina
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave
